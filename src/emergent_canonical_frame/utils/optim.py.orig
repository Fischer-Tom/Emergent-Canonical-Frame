import math

import torch
from omegaconf import DictConfig
from torch import nn
from torch.optim.lr_scheduler import LambdaLR


_LORA_PARAMETER_PARTS = frozenset(("A_q", "B_q", "A_k", "B_k", "A_v", "B_v"))


class Optimizer:
    """Bundles optimizer + LR scheduler + grad clipping for the training loop."""

    def __init__(self, model: nn.Module, total_iters: int, cfg: DictConfig):
        self.clip_grad_norm = cfg.get("clip_grad_norm", None)
        self.optimizer, self.scheduler = construct_optimizer(model, total_iters, cfg)
        self._params = [p for group in self.optimizer.param_groups for p in group["params"]]

    def zero_grad(self):
        self.optimizer.zero_grad(set_to_none=True)

    def step(self):
        if self.clip_grad_norm is not None:
            torch.nn.utils.clip_grad_norm_(self._params, self.clip_grad_norm)
        self.optimizer.step()
        self.scheduler.step()

    @property
    def lr(self):
        return self.scheduler.get_last_lr()[0]

    def state_dict(self):
        return {"optimizer": self.optimizer.state_dict(), "scheduler": self.scheduler.state_dict()}

    def load_state_dict(self, state_dict):
        self.optimizer.load_state_dict(state_dict["optimizer"])
        self.scheduler.load_state_dict(state_dict["scheduler"])


def construct_optimizer(model: torch.nn.Module, total_iters, cfg: DictConfig):
    lora_lr_start = float(cfg.get("lora_lr_start", cfg.lr_start))
    lora_lr_min = float(cfg.get("lora_lr_min", cfg.lr_min))
    params = split_parameters(
        model, cfg.weight_decay, cfg.lr_start, lora_lr_start
    )

    if cfg.name == "AdamW":
        optimizer = torch.optim.AdamW(params, lr=cfg.lr_start)
    elif cfg.name == "Adam":
        optimizer = torch.optim.Adam(params, lr=cfg.lr_start)
    elif cfg.name == "SGD":
        optimizer = torch.optim.SGD(params, lr=cfg.lr_start)
    else:
        raise NotImplementedError("Optimizer not implemented")

    warmup_iters = cfg.get("warmup_iters", 0)

    def make_lr_lambda(eta_min_ratio):
        def lr_lambda(step):
            if step >= total_iters - warmup_iters:
                return eta_min_ratio
            progress = step / (total_iters - warmup_iters)
            return eta_min_ratio + (1 - eta_min_ratio) * 0.5 * (
                1 + math.cos(math.pi * progress)
            )

        return lr_lambda

    lr_lambdas = [
        make_lr_lambda(
            lora_lr_min / lora_lr_start
            if group.get("is_lora", False)
            else cfg.lr_min / cfg.lr_start
        )
        for group in params
    ]
    cosine_scheduler = LambdaLR(optimizer, lr_lambda=lr_lambdas)

    return optimizer, cosine_scheduler


def split_parameters(
    model: torch.nn.Module,
    wd: float,
    lr: float,
    lora_lr: float,
):
    decay = set()
    no_decay = set()
    lora_params = set()
    whitelist_weight_modules = (nn.Conv2d, nn.ConvTranspose2d, nn.Linear, nn.MultiheadAttention, nn.Parameter)
    blacklist_weight_modules = (nn.LayerNorm, nn.BatchNorm2d, nn.GroupNorm, nn.Embedding)
    for mn, m in model.named_modules():
        for pn, p in m.named_parameters():
            fpn = "%s.%s" % (mn, pn) if mn else pn
            if not p.requires_grad:
                continue
            if any(part in _LORA_PARAMETER_PARTS for part in fpn.split(".")):
                lora_params.add(fpn)
            if pn.endswith("bias"):
                no_decay.add(fpn)
            elif pn.endswith("weight") and isinstance(m, blacklist_weight_modules):
                no_decay.add(fpn)
            elif pn.endswith("weight") and isinstance(m, whitelist_weight_modules):
                decay.add(fpn)
            elif pn in ("cls_token", "storage_tokens", "mask_token", "logit_scale", "mask_pos") or pn.endswith(".gamma"):
                no_decay.add(fpn)

    param_dict = {pn: p for pn, p in model.named_parameters() if p.requires_grad}
    inter_params = decay & no_decay
    union_params = decay | no_decay
    assert len(inter_params) == 0, "parameters %s made it into both decay/no_decay sets!" % (str(inter_params),)
    assert len(param_dict.keys() - union_params) == 0, (
        "parameters %s were not separated into either decay/no_decay set!" % (str(param_dict.keys() - union_params),)
    )

    lora_decay = decay & lora_params
    lora_no_decay = no_decay & lora_params
    other_decay = decay - lora_params
    other_no_decay = no_decay - lora_params

    optim_groups = [
        {
            "params": [param_dict[pn] for pn in sorted(other_decay)],
            "weight_decay": wd,
            "lr": lr,
            "is_lora": False,
        },
        {
            "params": [param_dict[pn] for pn in sorted(other_no_decay)],
            "weight_decay": 0.0,
            "lr": lr,
            "is_lora": False,
        },
        {
            "params": [param_dict[pn] for pn in sorted(lora_decay)],
            "weight_decay": wd,
            "lr": lora_lr,
            "is_lora": True,
        },
        {
            "params": [param_dict[pn] for pn in sorted(lora_no_decay)],
            "weight_decay": 0.0,
            "lr": lora_lr,
            "is_lora": True,
        },
    ]
    optim_groups = [g for g in optim_groups if len(g["params"]) > 0]
    return optim_groups
